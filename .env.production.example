# Copy to .env.production on the server and replace all placeholder secrets.
ERP_BACKEND_TAG=deploy-YYYYMMDD
ERP_FRONTEND_TAG=deploy-YYYYMMDD
POSTGRES_DB=erp_db
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
SECRET_KEY=REPLACE_WITH_FRESH_DJANGO_SECRET
DEBUG=False
ALLOWED_HOSTS=erp.nidhimasala.com
CORS_ALLOWED_ORIGINS=https://erp.nidhimasala.com
DATABASE_URL=postgres://erp_user:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/erp_db
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata
LLM_API_KEY=
ASSISTANT_MODEL_PROVIDER=openrouter
ASSISTANT_LLM_MODEL=anthropic/claude-haiku-5.5
STT_MODEL=mistralai/voxtral-mini-transcribe
BACKUP_ENABLED=True
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_RCLONE_REMOTE=
