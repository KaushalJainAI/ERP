# ──────────────────────────────────────────────────────────────
# PRODUCTION environment template for VPS deployment.
# On the server:  cp .env.production.example .env  &&  edit values.
# Read by config/settings.py via django-environ. The real `.env` is
# git-ignored; this template is safe to commit. See DEPLOYMENT.md.
# ──────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────
# Generate a UNIQUE key on the server, never reuse the dev key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_A_FRESHLY_GENERATED_SECRET

# Must be False in production.
DEBUG=False

# Your real domain(s). Add the server IP only if you must hit it directly.
ALLOWED_HOSTS=erp.example.com,www.erp.example.com

# ── Security (defaults shown; see DEPLOYMENT.md) ──────────────
# The backend refuses to start with DEBUG=False and a missing, short (<32) or
# example SECRET_KEY.
# Move the Django admin off /admin/ (update the nginx `location` to match).
ADMIN_URL=admin/
# Cookies only over HTTPS. Set both to False ONLY for a plain-HTTP LAN install.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# HSTS max-age in seconds (30 days). Raise to 31536000 once HTTPS is stable.
SECURE_HSTS_SECONDS=2592000
# nginx already redirects HTTP to HTTPS; enable if no proxy does.
SECURE_SSL_REDIRECT=False
# Shared cache for rate limits (default: file cache in backend/var/cache).
# CACHE_URL=redis://127.0.0.1:6379/1
# Nightly backup (manage.py backup_db at 01:30 via run_scheduler).
BACKUP_DIR=/var/backups/erp
BACKUP_RETENTION_DAYS=30
# Off-site copy with rclone (run `rclone config` first). Strongly recommended.
BACKUP_RCLONE_REMOTE=
# JWT lifetimes. Short access tokens limit the damage of a leaked token.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────
# Matches the role/db created in DATABASE.md.
DATABASE_URL=postgres://erp_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/erp_db

# ── CORS ──────────────────────────────────────────────────────
# HTTPS origins the SPA is served from (scheme + host, no trailing path).
CORS_ALLOWED_ORIGINS=https://erp.example.com,https://www.erp.example.com

# ── i18n ──────────────────────────────────────────────────────
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata

# ── AI assistant ──────────────────────────────────────────────
LLM_API_KEY=
ASSISTANT_MODEL_PROVIDER=openrouter
ASSISTANT_LLM_MODEL=anthropic/claude-haiku-5.5
STT_MODEL=mistralai/voxtral-mini-transcribe
