# ──────────────────────────────────────────────────────────────
# PRODUCTION environment template for VPS deployment.
# On the server:  cp .env.production.example .env  &&  edit values.
# Read by config/settings.py via django-environ. The real `.env` is
# git-ignored; this template is safe to commit. See DEPLOYMENT.md.
# ──────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────
# Generate a UNIQUE key on the server, never reuse the dev key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_A_FRESHLY_GENERATED_SECRET

# Must be False in production.
DEBUG=False

# Your real domain(s). Add the server IP only if you must hit it directly.
ALLOWED_HOSTS=erp.example.com,www.erp.example.com

# ── Database (PostgreSQL) ─────────────────────────────────────
# Matches the role/db created in DATABASE.md.
DATABASE_URL=postgres://erp_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/erp_db

# ── CORS ──────────────────────────────────────────────────────
# HTTPS origins the SPA is served from (scheme + host, no trailing path).
CORS_ALLOWED_ORIGINS=https://erp.example.com,https://www.erp.example.com

# ── i18n ──────────────────────────────────────────────────────
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata
