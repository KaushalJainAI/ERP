# Django core
SECRET_KEY=django-insecure-change-me-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Use PostgreSQL in production or SQLite by default if omitted
DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# i18n
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata

# AI assistant (OpenRouter). Copy LLM_API_KEY from the NGU backend's .env.
LLM_API_KEY=
ASSISTANT_MODEL_PROVIDER=openrouter
ASSISTANT_LLM_MODEL=anthropic/claude-haiku-5.5
STT_MODEL=mistralai/voxtral-mini-transcribe
# ASSISTANT_LLM_TIMEOUT < ASSISTANT_TURN_BUDGET_SECONDS < the proxy's read timeout.
# ASSISTANT_LLM_TIMEOUT=30
# ASSISTANT_TURN_BUDGET_SECONDS=75
# ASSISTANT_MAX_OUTPUT_TOKENS=1500
