msgstr ""
"आइटम '%(code)s' का बैच हिसाब नहीं बदल सकता: इसकी स्टॉक एंट्री पहले से हैं।"

#: stock/models.py:264
#, python-format
msgid "Value '%(value)s' does not belong to attribute '%(attribute)s'."
msgstr "मान '%(value)s' गुण '%(attribute)s' का नहीं है।"

#: stock/models.py:315
#, python-format
msgid "Warehouse account '%(account)s' belongs to a different company."
msgstr "गोदाम का खाता '%(account)s' किसी दूसरी कंपनी का है।"

#: stock/models.py:320
#, python-format
msgid "Warehouse account '%(account)s' must not be a group account."
msgstr "गोदाम का खाता '%(account)s' समूह खाता नहीं होना चाहिए।"

