#: accounts/bank_views.py:54 accounts/bank_views.py:73 core/mixins.py:129
#: users/serializers.py:207
msgid "This field is required."
msgstr "यह जानकारी ज़रूरी है।"

#: accounts/bank_views.py:65 accounts/reports/__init__.py:54
#: accounts/views.py:73 gst/reports/__init__.py:52
msgid "Enter a valid date (YYYY-MM-DD)."
msgstr "सही तारीख लिखें (YYYY-MM-DD)।"

#: accounts/bank_views.py:79
msgid "Must be a bank account id."
msgstr "यह बैंक खाते की id होनी चाहिए।"

#: accounts/bank_views.py:81
msgid "Bank account not found."
msgstr "बैंक खाता नहीं मिला।"

#: accounts/bank_views.py:86 accounts/services/bank.py:268
#: accounts/services/bank.py:313
msgid "Choose at least one voucher."
msgstr "कम से कम एक वाउचर चुनें।"

#: accounts/bank_views.py:95
msgid "Each voucher needs a voucher_type and voucher_no."
msgstr "हर वाउचर के लिए voucher_type और voucher_no ज़रूरी है।"

#: accounts/bank_views.py:193
msgid ""
"This bank account has statement or reconciliation history; deactivate it "
"instead."
msgstr ""
"इस बैंक खाते में स्टेटमेंट या मिलान का इतिहास है; इसे हटाने के बजाय बंद "
"करें।"

#: accounts/bank_views.py:304
msgid "Choose the account to book the amount to."
msgstr "वह खाता चुनें जिसमें रकम दर्ज करनी है।"

#: accounts/bank_views.py:306
msgid "Choose an active, non-group account."
msgstr "ऐसा खाता चुनें जो चालू हो और समूह न हो।"

#: accounts/bank_views.py:308
msgid "The counter account must differ from the bank."
msgstr "सामने वाला खाता बैंक से अलग होना चाहिए।"

#: accounts/bank_views.py:312 accounts/services/bank.py:275
msgid "This bank transaction is already reconciled."
msgstr "यह बैंक लेन-देन पहले ही मिलाया जा चुका है।"

#: accounts/bank_views.py:417
msgid "Choose a CSV file."
msgstr "CSV फ़ाइल चुनें।"

#: accounts/bank_views.py:419 accounts/services/bank_import.py:125
msgid "The file is too large (limit 5 MB)."
msgstr "फ़ाइल बहुत बड़ी है (सीमा 5 MB)।"

#: accounts/bank_views.py:449 accounts/bank_views.py:451
msgid "Invalid column mapping."
msgstr "कॉलम का मिलान गलत है।"

#: accounts/bank_views.py:456
msgid "Must be a number."
msgstr "यह एक संख्या होनी चाहिए।"

#: accounts/bank_views.py:531
msgid "Must be a number of days."
msgstr "यह दिनों की संख्या होनी चाहिए।"

#: accounts/bank_views.py:588 accounts/bank_views.py:615
msgid "Bank transaction not found."
msgstr "बैंक लेन-देन नहीं मिला।"

#: accounts/closing_views.py:64
msgid "Choose the closing account (Retained Earnings / Reserves)."
msgstr "समापन खाता चुनें (Retained Earnings / Reserves)।"

#: accounts/closing_views.py:84 accounts/services/closing.py:188
msgid "The closing account must belong to the company."
msgstr "समापन खाता इसी कंपनी का होना चाहिए।"

#: accounts/closing_views.py:92
msgid "The closing account must be a non-group Liability / Equity account."
msgstr "समापन खाता Liability / Equity का ऐसा खाता होना चाहिए जो समूह न हो।"

#: accounts/closing_views.py:105
msgid "The period end date must fall within the fiscal year."
msgstr "अवधि की आख़िरी तारीख वित्त वर्ष के अंदर होनी चाहिए।"

#: accounts/management/commands/build_opening_bills.py:35
#: core/test_hindi_api.py:46
#, python-format
msgid "Company '%(company)s' not found."
msgstr "कंपनी '%(company)s' नहीं मिली।"

#: accounts/management/commands/build_opening_bills.py:40
msgid "No company found."
msgstr "कोई कंपनी नहीं मिली।"

#: accounts/management/commands/build_opening_bills.py:105
msgid "Use either --dry-run or --commit, not both."
msgstr "--dry-run या --commit में से एक ही चुनें, दोनों नहीं।"

#: accounts/management/commands/build_opening_bills.py:110
#, python-format
msgid "Invalid --as-on date '%(date)s'. Expected YYYY-MM-DD."
msgstr "--as-on की तारीख '%(date)s' गलत है। YYYY-MM-DD लिखें।"

#: accounts/management/commands/build_opening_bills.py:129
#, python-format
msgid "Plan written to %(path)s."
msgstr "योजना %(path)s में लिख दी गई।"

#: accounts/management/commands/build_opening_bills.py:135
msgid "[DRY-RUN] No opening bills created. Use --commit to create them."
msgstr "[DRY-RUN] कोई शुरुआती बिल नहीं बना। बनाने के लिए --commit लगाएँ।"

#: accounts/management/commands/build_opening_bills.py:150
#, python-format
msgid ""
"Created %(count)s submitted opening bills for %(company)s as on %(as_on)s."
msgstr ""
"%(company)s के लिए %(as_on)s तक के %(count)s शुरुआती बिल बनाकर जमा किए गए।"

#: accounts/management/commands/build_opening_bills.py:165
#, python-format
msgid "%(path)s is missing the column(s): %(columns)s."
msgstr "%(path)s में ये कॉलम नहीं हैं: %(columns)s।"

#: accounts/management/commands/build_opening_bills.py:171
#, python-format
msgid "Cannot read %(path)s: %(error)s"
msgstr "%(path)s पढ़ नहीं सके: %(error)s"

#: accounts/management/commands/build_opening_bills.py:177
#, python-format
msgid "Opening bills for %(company)s as on %(as_on)s:"
msgstr "%(company)s के शुरुआती बिल, %(as_on)s तक:"

#: accounts/management/commands/build_opening_bills.py:181
#, python-format
msgid "  Bills: %(count)s, total %(total)s."
msgstr "  बिल: %(count)s, कुल %(total)s।"

#: accounts/management/commands/build_opening_bills.py:185
#, python-format
msgid "  Advances (credit balances, not bills): %(count)s, total %(total)s."
msgstr "  एडवांस (जमा बाकी, बिल नहीं): %(count)s, कुल %(total)s।"

#: accounts/management/commands/build_opening_bills.py:191
#, python-format
msgid "  Parties to review by hand: %(count)s."
msgstr "  हाथ से जाँचने वाली पार्टियाँ: %(count)s।"

#: accounts/management/commands/build_opening_bills.py:196
msgid "  Problems that block --commit:"
msgstr "  ये समस्याएँ --commit को रोकती हैं:"

#: accounts/mapping.py:52
#, python-format
msgid "Series '%(series)s' with 4-digit padding exceeds 16 characters."
msgstr "सीरीज़ '%(series)s' 4 अंकों के साथ 16 अक्षरों से लंबी हो जाती है।"

#: accounts/mapping.py:99
#, python-format
msgid "No %(what)s account is configured for company '%(company)s'."
msgstr "कंपनी '%(company)s' के लिए कोई %(what)s खाता सेट नहीं है।"

#: accounts/mapping.py:180
#, python-format
msgid "No Bank or Cash account is configured for company '%(company)s'."
msgstr "कंपनी '%(company)s' के लिए कोई बैंक या नकद खाता सेट नहीं है।"

#: accounts/mapping.py:300
#, python-format
msgid "'%(name)s' has already been returned in full."
msgstr "'%(name)s' पूरा वापस हो चुका है।"

#: accounts/mapping.py:307
msgid "A return can only be made from a submitted invoice."
msgstr "वापसी सिर्फ़ जमा किए गए बिल से हो सकती है।"

#: accounts/mapping.py:309
msgid "A return cannot be made from another return."
msgstr "वापसी से दूसरी वापसी नहीं हो सकती।"

#: accounts/mapping.py:356
msgid "Payment can only be requested for a submitted invoice."
msgstr "भुगतान सिर्फ़ जमा किए गए बिल के लिए माँगा जा सकता है।"

#: accounts/mapping.py:370
#, python-format
msgid "Invoice '%(name)s' has no outstanding amount."
msgstr "बिल '%(name)s' पर कुछ बाकी नहीं है।"

#: accounts/models.py:148
msgid "GLEntry rows are immutable and cannot be updated."
msgstr "GLEntry की पंक्तियाँ बदली नहीं जा सकतीं।"

#: accounts/models.py:153
msgid "GLEntry rows are immutable and cannot be deleted."
msgstr "GLEntry की पंक्तियाँ हटाई नहीं जा सकतीं।"

#: accounts/models.py:218 accounts/models.py:540 accounts/models.py:1987
#: assistant/proposals.py:985 assistant/proposals.py:1165 buying/models.py:470
#: hr/services/expense_claims.py:253
msgid "Proof attachment is required before submission."
msgstr "जमा करने से पहले सबूत (फ़ोटो या दस्तावेज़) लगाना ज़रूरी है।"

#: accounts/models.py:222
msgid "Journal Entry must have at least one line."
msgstr "जर्नल एंट्री में कम से कम एक पंक्ति होनी चाहिए।"

#: accounts/models.py:228
#, python-format
msgid "Account '%(account)s' does not belong to the entry's company."
msgstr "खाता '%(account)s' इस एंट्री की कंपनी का नहीं है।"

#: accounts/models.py:236
#, python-format
msgid ""
"Journal Entry is unbalanced: Total Debit (%(debit)s) != Total Credit "
"(%(credit)s)."
msgstr ""
"जर्नल एंट्री का जोड़ बराबर नहीं: कुल डेबिट (%(debit)s) != कुल क्रेडिट "
"(%(credit)s)।"

#: accounts/models.py:402
msgid "An internal transfer cannot be allocated against invoices."
msgstr "आपसी ट्रांसफ़र को बिलों से नहीं जोड़ा जा सकता।"

#: accounts/models.py:411
#, python-format
msgid ""
"Payments can only be allocated against a Sales Invoice or a Purchase "
"Invoice, not '%(doctype)s'."
msgstr ""
"भुगतान सिर्फ़ बिक्री बिल या खरीद बिल से जोड़ा जा सकता है, '%(doctype)s' से "
"नहीं।"

#: accounts/models.py:427 accounts/models.py:502
#, python-format
msgid ""
"A %(payment_type)s payment for a %(party_type)s cannot be allocated against "
"%(doctype)s '%(name)s'."
msgstr ""
"%(party_type)s का %(payment_type)s भुगतान %(doctype)s '%(name)s' से नहीं "
"जोड़ा जा सकता।"

#: accounts/models.py:440
#, python-format
msgid "Invoice '%(name)s' is referenced more than once."
msgstr "बिल '%(name)s' एक से ज़्यादा बार जोड़ा गया है।"

#: accounts/models.py:446
#, python-format
msgid "The amount allocated to '%(name)s' must be greater than zero."
msgstr "'%(name)s' पर लगाई गई रकम शून्य से ज़्यादा होनी चाहिए।"

#: accounts/models.py:452 accounts/serializers.py:359
#, python-format
msgid "Total allocated (%(allocated)s) exceeds the paid amount (%(paid)s)."
msgstr "कुल लगाई गई रकम (%(allocated)s) भुगतान (%(paid)s) से ज़्यादा है।"

#: accounts/models.py:467 payment_reconciliation/services.py:676
#, python-format
msgid "Invoice '%(name)s' does not exist."
msgstr "बिल '%(name)s' मौजूद नहीं है।"

#: accounts/models.py:472
#, python-format
msgid "Invoice '%(name)s' is not submitted."
msgstr "बिल '%(name)s' जमा नहीं किया गया है।"

#: accounts/models.py:477
#, python-format
msgid "Invoice '%(name)s' belongs to a different company."
msgstr "बिल '%(name)s' किसी दूसरी कंपनी का है।"

#: accounts/models.py:482
#, python-format
msgid "Invoice '%(name)s' belongs to a different party."
msgstr "बिल '%(name)s' किसी दूसरी पार्टी का है।"

#: accounts/models.py:491
#, python-format
msgid ""
"Invoice '%(name)s' is booked to a different account than this payment's "
"party account."
msgstr ""
"बिल '%(name)s' उस खाते में दर्ज है जो इस भुगतान की पार्टी का खाता नहीं है।"

#: accounts/models.py:522 accounts/serializers.py:344
#, python-format
msgid ""
"Allocated amount (%(allocated)s) exceeds the outstanding amount "
"(%(outstanding)s) of '%(name)s'."
msgstr ""
"लगाई गई रकम (%(allocated)s) '%(name)s' की बाकी रकम (%(outstanding)s) से "
"ज़्यादा है।"

#: accounts/models.py:543
msgid "Paid amount must be greater than zero."
msgstr "भुगतान की रकम शून्य से ज़्यादा होनी चाहिए।"

#: accounts/models.py:545 buying/models.py:518 selling/models.py:315
msgid "Posting to group accounts is not allowed."
msgstr "समूह खातों में एंट्री नहीं हो सकती।"

#: accounts/models.py:548
msgid "Paid From and Paid To accounts must be different."
msgstr "किस खाते से और किस खाते में, ये दोनों खाते अलग होने चाहिए।"

#: accounts/models.py:555
msgid "Payment accounts must belong to the payment's company."
msgstr "भुगतान के खाते उसी कंपनी के होने चाहिए।"

#: accounts/models.py:738
msgid "Opening bill amount must be greater than zero."
msgstr "शुरुआती बिल की रकम शून्य से ज़्यादा होनी चाहिए।"

#: accounts/models.py:740 accounts/services/terms.py:111 buying/models.py:482
msgid "Due date cannot be before the bill date."
msgstr "देय तारीख बिल की तारीख से पहले नहीं हो सकती।"

#: accounts/models.py:742
msgid "The bill date cannot be after the as-on date."
msgstr "बिल की तारीख as-on तारीख के बाद नहीं हो सकती।"

#: accounts/models.py:745
msgid "The party account must be a posting account of this company."
msgstr "पार्टी का खाता इसी कंपनी का एंट्री वाला खाता होना चाहिए।"

#: accounts/models.py:754
#, python-format
msgid "The party account must be a %(kind)s account."
msgstr "पार्टी का खाता %(kind)s खाता होना चाहिए।"

#: accounts/models.py:763
#, python-format
msgid "'%(party)s' is not a %(party_type)s of this company."
msgstr "'%(party)s' इस कंपनी का %(party_type)s नहीं है।"

#: accounts/models.py:787 accounts/models.py:1334
#, python-format
msgid ""
"Cannot cancel '%(name)s': cancel the linked payment entries first "
"(%(payments)s)."
msgstr ""
"'%(name)s' रद्द नहीं हो सकता: पहले इससे जुड़े भुगतान रद्द करें "
"(%(payments)s)।"

#: accounts/models.py:1256
#, python-format
msgid ""
"Cannot cancel '%(name)s': cancel the linked returns first (%(returns)s)."
msgstr ""
"'%(name)s' रद्द नहीं हो सकता: पहले इससे जुड़ी वापसी रद्द करें (%(returns)s)।"

#: accounts/models.py:1593
msgid "The GL account must be of type Bank."
msgstr "GL खाता Bank प्रकार का होना चाहिए।"

#: accounts/models.py:1595 buying/models.py:130
msgid "The GL account must not be a group."
msgstr "GL खाता समूह नहीं होना चाहिए।"

#: accounts/models.py:1597 buying/models.py:132
msgid "The GL account must belong to the company."
msgstr "GL खाता इसी कंपनी का होना चाहिए।"

#: accounts/models.py:1599
msgid "Enter a valid IFSC code (e.g. HDFC0001234)."
msgstr "सही IFSC कोड लिखें (जैसे HDFC0001234)।"

#: accounts/models.py:1642
msgid "Bank statement imports are immutable."
msgstr "बैंक स्टेटमेंट का आयात बदला नहीं जा सकता।"

#: accounts/models.py:1646
msgid "Bank statement imports cannot be deleted."
msgstr "बैंक स्टेटमेंट का आयात हटाया नहीं जा सकता।"

#: accounts/models.py:1706
msgid "Bank transactions are immutable."
msgstr "बैंक लेन-देन बदले नहीं जा सकते।"

#: accounts/models.py:1710
msgid "Bank transactions cannot be deleted."
msgstr "बैंक लेन-देन हटाए नहीं जा सकते।"

#: accounts/models.py:1762
msgid "Bank clearances are immutable; add a new record."
msgstr "बैंक क्लियरेंस बदला नहीं जा सकता; नई एंट्री जोड़ें।"

#: accounts/models.py:1766
msgid "Bank clearances cannot be deleted."
msgstr "बैंक क्लियरेंस हटाया नहीं जा सकता।"

#: accounts/models.py:1824
#, python-format
msgid "Period closing %(fy)s"
msgstr "अवधि समापन %(fy)s"

#: accounts/models.py:1940
msgid "GST tax payments cannot have TDS amount."
msgstr "GST टैक्स भुगतान में TDS की रकम नहीं हो सकती।"

#: accounts/models.py:1950
msgid "Tax payment must have at least one non-zero amount."
msgstr "टैक्स भुगतान में कम से कम एक रकम शून्य से अलग होनी चाहिए।"

#: accounts/models.py:1954
msgid "Paid From account is required when paying tax in cash."
msgstr "नकद में टैक्स भरते समय 'किस खाते से' ज़रूरी है।"

#: accounts/models.py:1965
msgid "TDS tax payments cannot have GST amounts."
msgstr "TDS टैक्स भुगतान में GST की रकम नहीं हो सकती।"

#: accounts/models.py:1967
msgid "TDS amount must be greater than zero."
msgstr "TDS की रकम शून्य से ज़्यादा होनी चाहिए।"

#: accounts/models.py:1970
msgid "Paid From account is required for TDS payment."
msgstr "TDS भुगतान के लिए 'किस खाते से' ज़रूरी है।"

#: accounts/models.py:1975
#, python-format
msgid "Paid From account does not belong to company '%(company)s'."
msgstr "'किस खाते से' वाला खाता कंपनी '%(company)s' का नहीं है।"

#: accounts/models.py:1979 accounts/services/tax_payment.py:84
msgid "Paid From account cannot be a group account."
msgstr "'किस खाते से' वाला खाता समूह नहीं हो सकता।"

#: accounts/reports/__init__.py:47 accounts/reports/__init__.py:71
#: gst/reports/__init__.py:93 gst/views.py:24 hr/views.py:100
#: stock/views.py:200
msgid "This query parameter is required."
msgstr "यह query parameter ज़रूरी है।"

#: accounts/reports/__init__.py:63 gst/reports/__init__.py:83
msgid "'from_date' is after 'to_date'."
msgstr "'from_date', 'to_date' के बाद है।"

#: accounts/reports/__init__.py:76
msgid "Enter a valid id."
msgstr "सही id लिखें।"

#: accounts/reports/__init__.py:85 gst/reports/__init__.py:99
msgid "A valid company is required."
msgstr "सही कंपनी ज़रूरी है।"

#: accounts/reports/__init__.py:97
#, python-format
msgid "'page' must be >= 1 and 'page_size' between 1 and %(max)d."
msgstr "'page' कम से कम 1 और 'page_size' 1 से %(max)d के बीच होना चाहिए।"

#: accounts/reports/cashbook.py:37
msgid "A valid account of this company is required."
msgstr "इस कंपनी का सही खाता ज़रूरी है।"

#: accounts/reports/cashbook.py:41
msgid "The account must be a Cash or Bank account."
msgstr "खाता नकद या बैंक खाता होना चाहिए।"

#: accounts/reports/registers.py:80 accounts/reports/statement.py:58
msgid "A valid party of this company is required."
msgstr "इस कंपनी की सही पार्टी ज़रूरी है।"

#: accounts/reports/registers.py:210
msgid "A valid item group is required."
msgstr "सही आइटम समूह ज़रूरी है।"

