msgid "'from_date' cannot be after 'to_date'."
msgstr "'from_date', 'to_date' के बाद नहीं हो सकती।"

#: selling/services/credit.py:136
#, python-format
msgid ""
"Credit limit crossed for %(customer)s: exposure %(total)s (existing "
"%(existing)s + this document %(document)s) exceeds limit %(limit)s."
msgstr ""
"%(customer)s की उधार सीमा पार: कुल उधार %(total)s (पहले का %(existing)s + यह"
" दस्तावेज़ %(document)s), सीमा %(limit)s से ज़्यादा है।"

#: selling/services/dispatch.py:250
msgid "Only submitted Sales Orders can be dispatched."
msgstr "सिर्फ़ जमा बिक्री ऑर्डर डिस्पैच हो सकते हैं।"

#: selling/services/dispatch.py:273
#, python-format
msgid "Order item %(id)s is not available for dispatch."
msgstr "ऑर्डर आइटम %(id)s डिस्पैच के लिए उपलब्ध नहीं है।"

#: selling/services/dispatch.py:304
#, python-format
msgid "Warehouse is required for item '%(code)s'."
msgstr "आइटम '%(code)s' के लिए गोदाम ज़रूरी है।"

#: selling/views.py:67
msgid "Expected a list of customer updates."
msgstr "ग्राहकों के बदलाव की सूची चाहिए थी।"

#: selling/views.py:175 selling/views.py:176
msgid "'lines' must be a list."
msgstr "'lines' एक सूची होनी चाहिए।"

#: selling/views.py:189 selling/views.py:192
msgid "Each line must include 'order_item_id' and 'qty'."
msgstr "हर लाइन में 'order_item_id' और 'qty' होना चाहिए।"

#: stock/models.py:161
#, python-format
msgid ""
"Item '%(code)s' already has stock ledger entries and cannot become a "
