msgstr "अनजान गुण मान।"

#: stock/serializers.py:294
#, python-format
msgid ""
"The abbreviation of '%(value)s' cannot change: variants already use it."
msgstr "'%(value)s' का छोटा नाम नहीं बदल सकता: वेरिएंट इसे इस्तेमाल करते हैं।"

#: stock/serializers.py:311
#, python-format
msgid "Value '%(value)s' is used by items."
msgstr "मान '%(value)s' आइटमों में इस्तेमाल हो रहा है।"

#: stock/serializers.py:392
#, python-format
msgid "Item '%(code)s' is a template with variants: pick one of its variants."
msgstr "आइटम '%(code)s' वेरिएंट वाला टेम्पलेट है: इसका कोई वेरिएंट चुनें।"

#: stock/serializers.py:401 stock/serializers.py:617 stock/serializers.py:744
#: stock/services/batches.py:180 stock/services/reconciliation.py:225
