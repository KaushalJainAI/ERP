#: stock/services/ledger.py:101 stock/services/ledger.py:401
#, python-format
msgid "Stock transaction not allowed on group warehouse '%(name)s'."
msgstr "समूह गोदाम '%(name)s' में स्टॉक का लेन-देन नहीं हो सकता।"

#: stock/services/ledger.py:154
#, python-format
msgid ""
"Transfer of '%(code)s': incoming quantity does not match the quantity taken "
