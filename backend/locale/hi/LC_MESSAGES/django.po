#, python-format
msgid ""
"Sales Invoice '%(name)s' does not update stock: remove the batch from item "
"'%(code)s'."
msgstr ""
"बिक्री बिल '%(name)s' से स्टॉक नहीं बदलता: आइटम '%(code)s' से बैच हटाएँ।"

#: selling/models.py:366
#, python-format
msgid "Item '%(code)s' is not batch-tracked; remove the batch."
msgstr "आइटम '%(code)s' बैच वाला नहीं है; बैच हटाएँ।"

#: selling/reports/kpis.py:100 selling/reports/kpis.py:102
msgid "Enter valid dates (YYYY-MM-DD)."
msgstr "सही तारीखें लिखें (YYYY-MM-DD)।"

